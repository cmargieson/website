---
import "leaflet/dist/leaflet.css";

interface Props {
  geojsonUrl: string;
  height?: string;
}

const { geojsonUrl, height = "400px" } = Astro.props;
---

<geo-json-map data-geojson={geojsonUrl}>
  <div class="map-container" style={`height: ${height};`}></div>
</geo-json-map>

<script>
  import L from "leaflet";

  class GeoJsonMap extends HTMLElement {
    async connectedCallback() {
      const geojsonUrl = this.dataset.geojson;
      const mapContainer = this.querySelector(".map-container") as HTMLElement;

      if (!geojsonUrl || !mapContainer) return;

      const map = L.map(mapContainer).setView([0, 0], 2);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution:
          '<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      try {
        const response = await fetch(geojsonUrl);
        if (!response.ok)
          throw new Error(`Failed to load GeoJSON: ${response.statusText}`);
        const geojsonData = await response.json();

        const routeLayer = L.geoJSON(geojsonData, {}).addTo(map);

        map.fitBounds(routeLayer.getBounds());
      } catch (error) {
        console.error("Error loading GeoJSON:", error);
      }
    }
  }

  customElements.define("geo-json-map", GeoJsonMap);
</script>
