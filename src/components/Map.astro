---
import "leaflet/dist/leaflet.css";

const { geojson } = Astro.props;
---

<geo-json-map data-geojson={JSON.stringify(geojson)}>
  <div class="map-container" style="height: 400px; width: 100%;"></div>
</geo-json-map>

<script>
  import L from "leaflet";

  class GeoJsonMap extends HTMLElement {
    async connectedCallback() {
      const mapContainer = this.querySelector(".map-container") as HTMLElement;
      const rawGeojson = this.dataset.geojson;

      if (!rawGeojson || !mapContainer) return;

      const map = L.map(mapContainer).setView([0, 0], 2);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution:
          '<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      try {
        const geojsonData = JSON.parse(rawGeojson);

        const routeLayer = L.geoJSON(geojsonData, {}).addTo(map);

        map.fitBounds(routeLayer.getBounds());
      } catch (error) {
        console.error("Error parsing or rendering GeoJSON data:", error);
      }
    }
  }

  customElements.define("geo-json-map", GeoJsonMap);
</script>
